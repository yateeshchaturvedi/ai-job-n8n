# ==============================================================================
# AI Job Search & Resume Tailoring Automation (n8n + PostgreSQL + DOCX Service)
# ==============================================================================
# Copy this file to .env and replace placeholder values before running:
#   cp .env.example .env

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=n8n_admin
POSTGRES_PASSWORD=change_me_postgres_secret_password
POSTGRES_DB=job_automation_db
POSTGRES_PORT=5432
POSTGRES_NON_ROOT_USER=n8n_worker
POSTGRES_NON_ROOT_PASSWORD=change_me_worker_secret_password

# ------------------------------------------------------------------------------
# 2. n8n Core & Security Configuration
# ------------------------------------------------------------------------------
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=change_me_32_byte_random_hex_encryption_key_here
N8N_USER_MANAGEMENT_JWT_SECRET=change_me_jwt_secret_for_n8n_auth
N8N_DEFAULT_BINARY_DATA_MODE=filesystem
N8N_PAYLOAD_SIZE_MAX=32
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336
GENERIC_TIMEZONE=UTC

# ------------------------------------------------------------------------------
# 3. DOCX & PDF Generation Microservice Configuration
# ------------------------------------------------------------------------------
DOCX_SERVICE_PORT=3001
DOCX_SERVICE_API_KEY=change_me_internal_docx_service_token
DOCX_STORAGE_DIR=/data/resumes
DOCX_URL_SIGNING_SECRET=change_me_hmac_signing_secret_for_expiring_links
DOCX_LINK_EXPIRY_SECONDS=86400
PUBLIC_DOCX_BASE_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# 4. LLM Provider Configuration (Configured in n8n Credentials or via Env)
# ------------------------------------------------------------------------------
# Supported providers: OpenAI (gpt-4o / gpt-4o-mini), Google Gemini (gemini-2.5-flash), Anthropic
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL_MATCHING=gpt-4o-mini
LLM_MODEL_TAILORING=gpt-4o
LLM_MODEL_QA=gpt-4o-mini

# ------------------------------------------------------------------------------
# 5. Job Source APIs & Web Search / Scraping Integrations
# ------------------------------------------------------------------------------
# Greenhouse & Lever public board tokens (comma-separated defaults if not in DB)
DEFAULT_GREENHOUSE_BOARDS=hashicorp,datadog,cloudflare,gitlab
DEFAULT_LEVER_BOARDS=palantir,netflix,spotify

# Firecrawl API (/v1/scrape & /v1/search) for permitted career page & job portal extraction
FIRECRAWL_API_KEY=fc-your_firecrawl_api_key_here
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v1

# JSearch (RapidAPI) / SerpApi / Adzuna for LinkedIn, Indeed, Glassdoor, ZipRecruiter, Naukri
JSEARCH_RAPIDAPI_KEY=your_rapidapi_jsearch_key_here
JSEARCH_RAPIDAPI_HOST=jsearch.p.rapidapi.com
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_API_KEY=your_adzuna_api_key
SERPAPI_API_KEY=your_serpapi_key
CAREER_PAGE_URLS=https://weworkremotely.com/categories/remote-devops-sysadmin-jobs.rss,https://remotive.com/api/remote-jobs?category=devops

# ------------------------------------------------------------------------------
# 6. Notification Channels (SMTP Email, Slack, Telegram)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_specific_password
SMTP_FROM="AI Job Search Agent <your_email@example.com>"
ADMIN_ALERT_EMAIL=admin@example.com

# Optional Slack / Telegram Fallback or Secondary Delivery
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/X000
TELEGRAM_BOT_TOKEN=123456789:ABCDEF_your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
