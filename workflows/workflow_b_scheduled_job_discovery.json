        "operation": "executeQuery",
        "query": "SELECT u.id AS user_id, u.email, u.schedule_enabled,\n       p.target_job_titles, p.technical_skills, p.preferred_locations,\n       p.excluded_companies, p.max_jobs_per_run, p.search_frequency\nFROM users u\nJOIN user_preferences p ON p.user_id = u.id\nWHERE u.is_active = TRUE AND u.schedule_enabled = TRUE\nLIMIT 1;",
